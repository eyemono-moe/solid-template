  },
  "devDependencies": {
    "@biomejs/biome": "2.3.8",
    "@unocss/preset-wind4": "66.5.10",
    "jsdom": "27.2.0",
    "typescript": "5.9.3",
    "unocss": "66.5.10",
    "vite": "7.2.6",
    "vite-plugin-solid": "2.11.10",
    "vitest": "4.0.15"
  },
  "packageManager": "pnpm@10.24.0"
}
